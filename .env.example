# Agenda QA — Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Gemini AI (V3: no longer needed client-side after api/gemini-proxy.ts is deployed)
# VITE_GEMINI_API_KEY=your_gemini_key_here   # DEPRECATED in V3 — use GEMINI_API_KEY in Vercel

# Feature flags
VITE_ENABLE_REALTIME=false   # Set to "true" only on Supabase Pro plan

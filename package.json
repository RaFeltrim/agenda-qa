{
  "name": "agenda-qa-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "npm run test",
    "test:pw": "npx playwright test",
    "test:pw:ui": "npx playwright test --ui",
    "test:pw:headed": "npx playwright test --headed",
    "test:pw:smoke": "npx playwright test --grep @smoke",
    "test:pw:regression": "npx playwright test --grep-invert @smoke",
    "test:cy": "npx cypress run --config-file cypress.config.ts",
    "test:cy:open": "npx cypress open --config-file cypress.config.ts",
    "test:e2e": "npm run test:pw && npm run test:cy",
    "test:all": "npm run test && npm run test:e2e",
    "test:optimized": "bash scripts/run-optimized-test-suite.sh",
    "test:optimized:win": "scripts\\run-optimized-test-suite.bat"
  },
  "dependencies": {
    "@ant-design/pro-components": "^2.6.43",
    "@ant-design/pro-utils": "^2.16.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.39.3",
    "antd": "^5.14.0",
    "dayjs": "^1.11.10",
    "lucide-react": "^0.330.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.55",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "cypress": "^15.10.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.46.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.53.1",
    "vite": "^5.1.0",
    "vitest": "^4.0.18"
  }
}